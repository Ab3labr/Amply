# YouTube Data API v3 key used only by the server-side music search route
# (`src/app/api/youtube/search/route.ts`). Create a key in Google Cloud Console,
# enable "YouTube Data API v3", and keep it server-side. Never expose it in
# client-side JavaScript or commit a real key.
YOUTUBE_API_KEY=

# Optional. Override the YouTube API base URL (defaults to the official
# https://www.googleapis.com/youtube/v3). Useful for local integration tests
# against a mock server; leave unset in normal use.
# YOUTUBE_API_BASE_URL=
